TELEGRAM_BOT_TOKEN=
DATABASE_URL=
APP_ENV=development
LOG_LEVEL=INFO
QUEUE_NAME=media_jobs
QUEUE_VISIBILITY_SECONDS=60

QUEUE_MAX_ATTEMPTS=3
QUEUE_HEARTBEAT_SECONDS=20
QUEUE_LONG_JOB_VISIBILITY_SECONDS=300
MEDIA_MAX_BYTES=100000000

TELEGRAM_HOSTED_UPLOAD_LIMIT_BYTES=49000000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRESIGN_SECONDS=3600

ARCHIVE_PRESIGN_SECONDS=900

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_MASTER_KEY=
# Beta service account credentials. Keep only in the worker secret store.
INSTAGRAM_SESSION_USERNAME=
INSTAGRAM_SESSION_PASSWORD=

# Public Story provider. Keep the token only on the worker service.
APIFY_API_TOKEN=
APIFY_STORIES_ACTOR_ID=mmsVe3IhljF36qhot
APIFY_MAX_TOTAL_CHARGE_USD=0.05
APIFY_STORY_LIMIT=10

# Comma-separated numeric Telegram user IDs. Admins bypass watch-slot limits.
ADMIN_TELEGRAM_USER_IDS=

# Fast abuse controls. Leave blank in local development to use conservative in-process fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
PROVIDER_INSTAGRAM_CONCURRENCY=2

LIVE_MAX_CONCURRENT_RECORDINGS=1
LIVE_SEGMENT_SECONDS=60
LIVE_HARD_MAX_MINUTES=120
LIVE_WORK_DIR=/tmp/social-saver-live
LIVE_ALLOW_MANUAL_SOURCE=false

# Exact comma-separated Mini App origins. Never use * in production.
API_CORS_ORIGINS=https://your-mini-app.example.com
